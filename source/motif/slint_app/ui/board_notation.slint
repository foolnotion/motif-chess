import { Button, Palette, StyleMetrics } from "std-widgets.slint";

export struct BoardSquare {
    file: int,
    rank: int,
}

// Mirrors motif::slint_app::square_highlight (motif/slint_app/board_presenter.hpp).
export enum SquareHighlight { none, selected, legal-target, last-move-from, last-move-to }

component ChessPiece inherits Image {
    in property <string> code;

    pure function piece-image(value: string) -> image {
        if (value == "wK") { return @image-url("pieces/wK.svg"); }
        if (value == "wQ") { return @image-url("pieces/wQ.svg"); }
        if (value == "wR") { return @image-url("pieces/wR.svg"); }
        if (value == "wB") { return @image-url("pieces/wB.svg"); }
        if (value == "wN") { return @image-url("pieces/wN.svg"); }
        if (value == "wP") { return @image-url("pieces/wP.svg"); }
        if (value == "bK") { return @image-url("pieces/bK.svg"); }
        if (value == "bQ") { return @image-url("pieces/bQ.svg"); }
        if (value == "bR") { return @image-url("pieces/bR.svg"); }
        if (value == "bB") { return @image-url("pieces/bB.svg"); }
        if (value == "bN") { return @image-url("pieces/bN.svg"); }
        if (value == "bP") { return @image-url("pieces/bP.svg"); }
        return @image-url("");
    }

    source: root.piece-image(root.code);
    image-fit: contain;
}

// Renders an 8x8 board from presenter-supplied square data only. Never
// derives piece placement or legal moves from a FEN string itself.
export component BoardPanel inherits Rectangle {
    in property <[string]> square-pieces;
    in property <[SquareHighlight]> square-highlights;
    in property <bool> flipped;
    in property <bool> board-loaded;
    in property <bool> interaction-enabled: true;
    callback square-activated(int, int);

    pure function display-file(col: int) -> int {
        return root.flipped ? 7 - col : col;
    }
    pure function display-rank(row: int) -> int {
        return root.flipped ? row : 7 - row;
    }
    pure function highlight-overlay(h: SquareHighlight) -> color {
        if (h == SquareHighlight.selected) {
            return #4fc3f766;
        }
        if (h == SquareHighlight.last-move-from || h == SquareHighlight.last-move-to) {
            return #d4bc7855;
        }
        return transparent;
    }

    property <length> label-size: 16px;
    // The board takes the largest square that fits the space the parent grants
    // it, so it grows with the window instead of sitting at a fixed size.
    property <length> extent: Math.min(self.width, self.height);
    property <length> square-size: (root.extent - root.label-size) / 8;

    // Pinned to constants so this element's layout-info never depends on the
    // children whose sizes are in turn derived from `extent`; deriving both
    // directions would form a binding loop.
    min-width: 220px;
    min-height: 220px;
    preferred-width: 480px;
    preferred-height: 480px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    background: Palette.background;

    board-scope := FocusScope {
        x: (root.width - root.extent) / 2;
        y: (root.height - root.extent) / 2;
        width: root.extent;
        height: root.extent;
        focus-on-tab-navigation: root.board-loaded && root.interaction-enabled;
        // focused-file/ranked-rank start as declarative bindings but are
        // replaced with fixed values after the first arrow-key press; the
        // `changed` handlers re-mirror the orientation so a flip while a
        // square is focused moves focus to the mirrored square instead of
        // yanking it back to a corner.
        property <int> focused-file: root.flipped ? 7 : 0;
        accessible-role: button;
        accessible-label: root.string-from-char-code(97 + self.focused-file) + (self.focused-rank + 1);
        accessible-action-default => {
            if (root.board-loaded && root.interaction-enabled) {
                root.square-activated(self.focused-file, self.focused-rank);
            }
        }
        property <int> focused-rank: root.flipped ? 7 : 0;
        property <bool> was-flipped: root.flipped;
        changed was-flipped => {
            self.focused-file = 7 - self.focused-file;
            self.focused-rank = 7 - self.focused-rank;
        }
        key-pressed(event) => {
            if (!root.board-loaded || !root.interaction-enabled) {
                return reject;
            }
            if (event.text == Key.LeftArrow) {
                self.focused-file = max(0, self.focused-file - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                self.focused-file = min(7, self.focused-file + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                self.focused-rank = min(7, self.focused-rank + 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                self.focused-rank = max(0, self.focused-rank - 1);
                return accept;
            }
            if (event.text == "\n" || event.text == " ") {
                root.square-activated(self.focused-file, self.focused-rank);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: root.extent;
            height: root.extent;
            for row in 8: HorizontalLayout {
                height: root.square-size;
                Text {
                    width: root.label-size;
                    height: root.square-size;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-size: 10px;
                    color: Palette.alternate-foreground;
                    text: root.display-rank(row) + 1;
                }
                for col in 8: sq := Rectangle {
                    property <int> file: root.display-file(col);
                    property <int> rank: root.display-rank(row);
                    property <int> idx: sq.rank * 8 + sq.file;
                    property <SquareHighlight> highlight: root.square-highlights.length > sq.idx ? root.square-highlights[sq.idx] : SquareHighlight.none;
                    width: root.square-size;
                    height: root.square-size;
                    background: Math.mod(sq.file + sq.rank, 2) == 0 ? #b58863 : #f0d9b5;
                    Rectangle {
                        background: root.highlight-overlay(sq.highlight);
                    }
                    if board-scope.has-focus && board-scope.focused-file == sq.file && board-scope.focused-rank == sq.rank: Rectangle {
                        border-width: 3px;
                        border-color: Palette.selection-foreground;
                        background: transparent;
                    }
                    if sq.highlight == SquareHighlight.legal-target: Rectangle {
                        width: root.square-size * 0.3;
                        height: root.square-size * 0.3;
                        border-radius: root.square-size * 0.15;
                        background: #4fc3f7aa;
                    }
                    ChessPiece {
                        code: root.square-pieces.length > sq.idx ? root.square-pieces[sq.idx] : "";
                        width: parent.width * 0.88;
                        height: parent.height * 0.88;
                    }
                    TouchArea {
                        enabled: root.board-loaded && root.interaction-enabled;
                        clicked => {
                            board-scope.focused-file = sq.file;
                            board-scope.focused-rank = sq.rank;
                            board-scope.focus();
                            root.square-activated(sq.file, sq.rank);
                        }
                    }
                }
            }
            HorizontalLayout {
                height: root.label-size;
                Rectangle { width: root.label-size; }
                for col in 8: Text {
                    width: root.square-size;
                    horizontal-alignment: center;
                    font-size: 10px;
                    color: Palette.alternate-foreground;
                    text: string-from-char-code(97 + root.display-file(col));
                }
            }
        }
    }

    pure function string-from-char-code(code: int) -> string {
        if (code == 97) { return "a"; }
        if (code == 98) { return "b"; }
        if (code == 99) { return "c"; }
        if (code == 100) { return "d"; }
        if (code == 101) { return "e"; }
        if (code == 102) { return "f"; }
        if (code == 103) { return "g"; }
        return "h";
    }
}

// Renders headers/result/SAN moves as inline, wrapping paragraph-style
// notation, packing a fixed count of half-moves per row (Slint has no
// automatic reflow layout for variable-width children in this toolchain
// version, so wrapping is grouped by count rather than measured pixel
// width). Click or activate a token to jump directly to that ply.
export component NotationPanel inherits Rectangle {
    in property <string> white-name;
    in property <string> black-name;
    in property <string> event-name;
    in property <string> date;
    in property <string> result;
    in property <[string]> san-moves;
    in property <int> current-ply;
    in property <bool> interaction-enabled: true;
    callback ply-activated(int);

    property <int> units-per-row: 6;
    property <int> unit-count: root.san-moves.length;
    // (unit-count + units-per-row - 1) / units-per-row: ceil without the
    // truncating integer division inside Math.ceil, which floors first
    // and would hide the final partial row of moves.
    property <int> row-count: (root.unit-count + root.units-per-row - 1) / root.units-per-row;

    background: Palette.background;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        if root.white-name != "" || root.black-name != "": Text {
            text: root.white-name + " – " + root.black-name;
            color: Palette.foreground;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
        }
        if root.event-name != "" || root.date != "": Text {
            text: root.event-name != "" && root.date != "" ? root.event-name + " · " + root.date : root.event-name + root.date;
            color: Palette.alternate-foreground;
            font-size: 11px;
            wrap: word-wrap;
        }

        Flickable {
            vertical-stretch: 1;
            viewport-height: rows.preferred-height;
            rows := VerticalLayout {
                spacing: 4px;
                for row-index in root.row-count: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for col in root.units-per-row: cell := Rectangle {
                        property <int> idx: row-index * root.units-per-row + col;
                        visible: cell.idx < root.unit-count;
                        width: cell.visible ? content.preferred-width : 0px;
                        height: content.preferred-height;
                        content := HorizontalLayout {
                            spacing: 2px;
                            if Math.mod(cell.idx, 2) == 0: Text {
                                text: Math.floor(cell.idx / 2) + 1 + ".";
                                color: Palette.alternate-foreground;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            move-scope := FocusScope {
                                focus-on-tab-navigation: root.interaction-enabled;
                                accessible-role: button;
                                accessible-label: "Move " + (cell.idx + 1) + ": " + (cell.idx < root.san-moves.length ? root.san-moves[cell.idx] : "");
                                accessible-action-default => {
                                    if (root.interaction-enabled) {
                                        root.ply-activated(cell.idx + 1);
                                    }
                                }
                                width: move-text.preferred-width + 8px;
                                height: move-text.preferred-height;
                                key-pressed(event) => {
                                    if (root.interaction-enabled && (event.text == "\n" || event.text == " ")) {
                                        root.ply-activated(cell.idx + 1);
                                        return accept;
                                    }
                                    return reject;
                                }
                                move-text := Text {
                                    x: 4px;
                                    height: parent.height;
                                    text: cell.idx < root.san-moves.length ? root.san-moves[cell.idx] : "";
                                    color: cell.idx + 1 == root.current-ply ? Palette.accent-background : Palette.foreground;
                                    font-weight: cell.idx + 1 == root.current-ply ? 700 : 400;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    enabled: root.interaction-enabled;
                                    clicked => {
                                        move-scope.focus();
                                        root.ply-activated(cell.idx + 1);
                                    }
                                }
                            }
                        }
                    }
                    }
                if root.result != "": Text {
                    text: root.result;
                    color: Palette.alternate-foreground;
                    font-weight: 700;
                    font-size: 13px;
                }
            }
        }
    }
}

component ReplayIconButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> icon-path;
    callback clicked();

    min-width: control-button.preferred-width;
    min-height: control-button.preferred-height;
    preferred-width: control-button.preferred-width;
    preferred-height: control-button.preferred-height;

    control-button := Button {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }

    Path {
        width: Math.min(parent.width, parent.height) * 0.56;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-path;
        fill: root.enabled ? Palette.foreground : Palette.alternate-foreground;
    }
}

component BoardAndControls inherits Rectangle {
    in property <bool> board-loaded;
    in property <[string]> square-pieces;
    in property <[SquareHighlight]> square-highlights;
    in property <bool> flipped;
    in property <bool> interaction-enabled: true;

    callback square-activated(int, int);
    callback navigate-first();
    callback navigate-previous();
    callback navigate-next();
    callback navigate-last();
    callback orientation-toggled();

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        spacing: StyleMetrics.layout-spacing;
        BoardPanel {
            vertical-stretch: 1;
            square-pieces: root.square-pieces;
            board-loaded: root.board-loaded;
            square-highlights: root.square-highlights;
            flipped: root.flipped;
            interaction-enabled: root.interaction-enabled;
            square-activated(file, rank) => { root.square-activated(file, rank); }
        }
        HorizontalLayout {
            spacing: StyleMetrics.layout-spacing;
            ReplayIconButton { label: "First move"; icon-path: "M5 5 L7 5 L7 19 L5 19 Z M19 5 L9 12 L19 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-first(); } }
            ReplayIconButton { label: "Previous move"; icon-path: "M17 5 L7 12 L17 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-previous(); } }
            ReplayIconButton { label: "Next move"; icon-path: "M7 5 L17 12 L7 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-next(); } }
            ReplayIconButton { label: "Last move"; icon-path: "M17 5 L19 5 L19 19 L17 19 Z M5 5 L15 12 L5 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-last(); } }
            ReplayIconButton { label: "Flip board"; icon-path: "M7.6 6.4 A7.9 7.9 0 0 1 19.2 10 L22 10 L18 14 L14 10 L16.9 10 A5.8 5.8 0 0 0 8.8 8.2 Z M6 10 L10 14 L7.1 14 A5.8 5.8 0 0 0 15.2 15.8 L16.4 17.6 A7.9 7.9 0 0 1 4.8 14 L2 14 Z"; enabled: root.interaction-enabled; clicked => { root.orientation-toggled(); } }
        }
    }
}

// Wraps board + notation with navigation, orientation, and a
// keyboard-accessible hide/restore control for the whole region. Hiding
// collapses the content to zero layout reservation via `if`.
export component GameReviewPanel inherits Rectangle {
    in property <bool> board-loaded;
    in property <[string]> square-pieces;
    in property <[SquareHighlight]> square-highlights;
    in property <bool> flipped;
    in property <string> white-name;
    in property <string> black-name;
    in property <string> event-name;
    in property <string> date;
    in property <string> result;
    in property <[string]> san-moves;
    in property <int> current-ply;
    in property <bool> interaction-enabled: true;
    in property <bool> notation-below: false;

    callback square-activated(int, int);
    callback ply-activated(int);
    callback navigate-first();
    callback navigate-previous();
    callback navigate-next();
    callback navigate-last();
    callback orientation-toggled();
    callback panel-visibility-toggled();
    callback notation-layout-toggled();

    background: Palette.background;

    VerticalLayout {
        padding: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;

        HorizontalLayout {
            height: 26px;
            Text {
                horizontal-stretch: 1;
                text: "Board & Notation";
                color: Palette.alternate-foreground;
                font-weight: 700;
                vertical-alignment: center;
            }
            Button {
                text: root.notation-below ? "Notation Right" : "Notation Below";
                enabled: root.interaction-enabled;
                clicked => { root.notation-layout-toggled(); }
            }
            visibility-scope := FocusScope {
                height: parent.height;
                focus-on-tab-navigation: root.interaction-enabled;
                width: visibility-button.preferred-width;
                key-pressed(event) => {
                    if (root.interaction-enabled && (event.text == "\n" || event.text == " ")) {
                        root.panel-visibility-toggled();
                        return accept;
                    }
                    return reject;
                }
                visibility-button := Button {
                    height: parent.height;
                    enabled: root.interaction-enabled;
                    text: "Hide";
                    clicked => {
                        visibility-scope.focus();
                        root.panel-visibility-toggled();
                    }
                }
            }
        }

        keyboard-scope := FocusScope {
            vertical-stretch: 1;
            // Loading a game is the user's clearest signal of intent to
            // navigate it; without this, arrow-key navigation silently does
            // nothing until the user first clicks the board or a move,
            // which is not discoverable and fails keyboard-only use.
            property <bool> can-auto-focus: root.board-loaded && root.interaction-enabled;
            changed can-auto-focus => {
                if (self.can-auto-focus) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                if (!root.interaction-enabled) {
                    return reject;
                }
                if (event.text == Key.LeftArrow) {
                    root.navigate-previous();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.navigate-next();
                    return accept;
                }
                if (event.text == Key.Home) {
                    root.navigate-first();
                    return accept;
                }
                if (event.text == Key.End) {
                    root.navigate-last();
                    return accept;
                }
                return reject;
            }

            if root.notation-below: Rectangle {
                BoardAndControls {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height / 2 - 6px;
                    board-loaded: root.board-loaded;
                    square-pieces: root.square-pieces;
                    square-highlights: root.square-highlights;
                    flipped: root.flipped;
                    interaction-enabled: root.interaction-enabled;
                    square-activated(file, rank) => { keyboard-scope.focus(); root.square-activated(file, rank); }
                    navigate-first() => { keyboard-scope.focus(); root.navigate-first(); }
                    navigate-previous() => { keyboard-scope.focus(); root.navigate-previous(); }
                    navigate-next() => { keyboard-scope.focus(); root.navigate-next(); }
                    navigate-last() => { keyboard-scope.focus(); root.navigate-last(); }
                    orientation-toggled() => { root.orientation-toggled(); }
                }
                NotationPanel {
                    x: 0px;
                    y: parent.height / 2 + 6px;
                    width: parent.width;
                    height: parent.height / 2 - 6px;
                    white-name: root.white-name;
                    black-name: root.black-name;
                    event-name: root.event-name;
                    date: root.date;
                    result: root.result;
                    san-moves: root.san-moves;
                    current-ply: root.current-ply;
                    interaction-enabled: root.interaction-enabled;
                    ply-activated(ply) => { keyboard-scope.focus(); root.ply-activated(ply); }
                }
            }
            if !root.notation-below: Rectangle {
                BoardAndControls {
                    x: 0px;
                    y: 0px;
                    width: parent.width / 2 - 6px;
                    height: parent.height;
                    board-loaded: root.board-loaded;
                    square-pieces: root.square-pieces;
                    square-highlights: root.square-highlights;
                    flipped: root.flipped;
                    interaction-enabled: root.interaction-enabled;
                    square-activated(file, rank) => { keyboard-scope.focus(); root.square-activated(file, rank); }
                    navigate-first() => { keyboard-scope.focus(); root.navigate-first(); }
                    navigate-previous() => { keyboard-scope.focus(); root.navigate-previous(); }
                    navigate-next() => { keyboard-scope.focus(); root.navigate-next(); }
                    navigate-last() => { keyboard-scope.focus(); root.navigate-last(); }
                    orientation-toggled() => { root.orientation-toggled(); }
                }
                NotationPanel {
                    x: parent.width / 2 + 6px;
                    y: 0px;
                    width: parent.width / 2 - 6px;
                    height: parent.height;
                    white-name: root.white-name;
                    black-name: root.black-name;
                    event-name: root.event-name;
                    date: root.date;
                    result: root.result;
                    san-moves: root.san-moves;
                    current-ply: root.current-ply;
                    interaction-enabled: root.interaction-enabled;
                    ply-activated(ply) => { keyboard-scope.focus(); root.ply-activated(ply); }
                }
            }
        }
    }
}
