import { Button, Palette, StyleMetrics } from "std-widgets.slint";

export struct BoardSquare {
    file: int,
    rank: int,
}

// One move of the notation in PGN order (motif::slint_app::notation_token).
// `lead` is the opening parentheses plus the move number, `trail` the closing
// parentheses; `depth` is 0 on the main line.
export struct NotationToken {
    lead: string,
    san: string,
    trail: string,
    node: int,
    depth: int,
}

// Mirrors motif::slint_app::square_highlight (motif/slint_app/board_presenter.hpp).
export enum SquareHighlight { none, selected, legal-target, last-move-from, last-move-to }

component ChessPiece inherits Image {
    in property <string> code;

    pure function piece-image(value: string) -> image {
        if (value == "wK") { return @image-url("pieces/wK.svg"); }
        if (value == "wQ") { return @image-url("pieces/wQ.svg"); }
        if (value == "wR") { return @image-url("pieces/wR.svg"); }
        if (value == "wB") { return @image-url("pieces/wB.svg"); }
        if (value == "wN") { return @image-url("pieces/wN.svg"); }
        if (value == "wP") { return @image-url("pieces/wP.svg"); }
        if (value == "bK") { return @image-url("pieces/bK.svg"); }
        if (value == "bQ") { return @image-url("pieces/bQ.svg"); }
        if (value == "bR") { return @image-url("pieces/bR.svg"); }
        if (value == "bB") { return @image-url("pieces/bB.svg"); }
        if (value == "bN") { return @image-url("pieces/bN.svg"); }
        if (value == "bP") { return @image-url("pieces/bP.svg"); }
        return @image-url("");
    }

    source: root.piece-image(root.code);
    image-fit: contain;
}

// Renders an 8x8 board from presenter-supplied square data only. Never
// derives piece placement or legal moves from a FEN string itself.
export component BoardPanel inherits Rectangle {
    in property <[string]> square-pieces;
    in property <[SquareHighlight]> square-highlights;
    in property <bool> flipped;
    in property <bool> interaction-enabled: true;
    // A pawn move to the last rank waits for the piece to promote to.
    in property <bool> promotion-pending: false;
    in property <bool> promotion-white: true;
    callback square-activated(int, int);
    callback promotion-chosen(string);
    callback promotion-cancelled();

    pure function display-file(col: int) -> int {
        return root.flipped ? 7 - col : col;
    }
    pure function display-rank(row: int) -> int {
        return root.flipped ? row : 7 - row;
    }
    pure function highlight-overlay(h: SquareHighlight) -> color {
        if (h == SquareHighlight.selected) {
            return #4fc3f766;
        }
        if (h == SquareHighlight.last-move-from || h == SquareHighlight.last-move-to) {
            return #d4bc7855;
        }
        return transparent;
    }

    property <length> label-size: 16px;
    // The board takes the largest square that fits the space the parent grants
    // it, so it grows with the window instead of sitting at a fixed size.
    property <length> extent: Math.min(self.width, self.height);
    property <length> square-size: (root.extent - root.label-size) / 8;

    // Pinned to constants so this element's layout-info never depends on the
    // children whose sizes are in turn derived from `extent`; deriving both
    // directions would form a binding loop.
    min-width: 220px;
    min-height: 220px;
    preferred-width: 480px;
    preferred-height: 480px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    background: Palette.background;

    board-scope := FocusScope {
        x: (root.width - root.extent) / 2;
        y: (root.height - root.extent) / 2;
        width: root.extent;
        height: root.extent;
        focus-on-tab-navigation: root.interaction-enabled;
        // focused-file/ranked-rank start as declarative bindings but are
        // replaced with fixed values after the first arrow-key press; the
        // `changed` handlers re-mirror the orientation so a flip while a
        // square is focused moves focus to the mirrored square instead of
        // yanking it back to a corner.
        property <int> focused-file: root.flipped ? 7 : 0;
        accessible-role: button;
        accessible-label: root.string-from-char-code(97 + self.focused-file) + (self.focused-rank + 1);
        accessible-action-default => {
            if (root.interaction-enabled) {
                root.square-activated(self.focused-file, self.focused-rank);
            }
        }
        property <int> focused-rank: root.flipped ? 7 : 0;
        property <bool> was-flipped: root.flipped;
        changed was-flipped => {
            self.focused-file = 7 - self.focused-file;
            self.focused-rank = 7 - self.focused-rank;
        }
        key-pressed(event) => {
            if (!root.interaction-enabled) {
                return reject;
            }
            if (root.promotion-pending) {
                // The picker owns Q/R/B/N and Escape; any other key (arrows,
                // Home, End) falls through and abandons the pending move.
                if (event.text == Key.Escape) {
                    root.promotion-cancelled();
                    return accept;
                }
                if (event.text.to-lowercase() == "q" || event.text.to-lowercase() == "r" || event.text.to-lowercase() == "b" || event.text.to-lowercase() == "n") {
                    root.promotion-chosen(event.text.to-lowercase());
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.LeftArrow) {
                self.focused-file = max(0, self.focused-file - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                self.focused-file = min(7, self.focused-file + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                self.focused-rank = min(7, self.focused-rank + 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                self.focused-rank = max(0, self.focused-rank - 1);
                return accept;
            }
            if (event.text == "\n" || event.text == " ") {
                root.square-activated(self.focused-file, self.focused-rank);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: root.extent;
            height: root.extent;
            for row in 8: HorizontalLayout {
                height: root.square-size;
                Text {
                    width: root.label-size;
                    height: root.square-size;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-size: 10px;
                    color: Palette.alternate-foreground;
                    text: root.display-rank(row) + 1;
                }
                for col in 8: sq := Rectangle {
                    property <int> file: root.display-file(col);
                    property <int> rank: root.display-rank(row);
                    property <int> idx: sq.rank * 8 + sq.file;
                    property <SquareHighlight> highlight: root.square-highlights.length > sq.idx ? root.square-highlights[sq.idx] : SquareHighlight.none;
                    width: root.square-size;
                    height: root.square-size;
                    background: Math.mod(sq.file + sq.rank, 2) == 0 ? #b58863 : #f0d9b5;
                    Rectangle {
                        background: root.highlight-overlay(sq.highlight);
                    }
                    if board-scope.has-focus && board-scope.focused-file == sq.file && board-scope.focused-rank == sq.rank: Rectangle {
                        border-width: 3px;
                        border-color: Palette.selection-foreground;
                        background: transparent;
                    }
                    if sq.highlight == SquareHighlight.legal-target: Rectangle {
                        width: root.square-size * 0.3;
                        height: root.square-size * 0.3;
                        border-radius: root.square-size * 0.15;
                        background: #4fc3f7aa;
                    }
                    ChessPiece {
                        code: root.square-pieces.length > sq.idx ? root.square-pieces[sq.idx] : "";
                        width: parent.width * 0.88;
                        height: parent.height * 0.88;
                    }
                    TouchArea {
                        enabled: root.interaction-enabled;
                        clicked => {
                            board-scope.focused-file = sq.file;
                            board-scope.focused-rank = sq.rank;
                            board-scope.focus();
                            root.square-activated(sq.file, sq.rank);
                        }
                    }
                }
            }
            HorizontalLayout {
                height: root.label-size;
                Rectangle { width: root.label-size; }
                for col in 8: Text {
                    width: root.square-size;
                    horizontal-alignment: center;
                    font-size: 10px;
                    color: Palette.alternate-foreground;
                    text: string-from-char-code(97 + root.display-file(col));
                }
            }
        }

        if root.promotion-pending: Rectangle {
            x: 0px;
            y: 0px;
            width: root.extent;
            height: root.extent;
            background: #00000066;
            // Swallows pointer input meant for the squares underneath.
            TouchArea {
                clicked => { root.promotion-cancelled(); }
            }
            promotion-card := Rectangle {
                width: min(root.extent - 16px, root.square-size * 4 + 76px);
                height: root.square-size + 76px;
                x: (root.extent - self.width) / 2;
                y: (root.extent - self.height) / 2;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.alternate-background;
                accessible-role: groupbox;
                accessible-label: "Promote pawn";
                TouchArea { }
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    Text {
                        height: 16px;
                        text: "Promote to (Q, R, B, N · Esc cancels)";
                        color: Palette.foreground;
                        font-size: 11px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        for kind[idx] in ["Q", "R", "B", "N"]: Rectangle {
                            width: root.square-size;
                            height: root.square-size;
                            border-radius: 4px;
                            background: piece-touch.has-hover ? Palette.selection-background : #b58863;
                            accessible-role: button;
                            accessible-label: "Promote to " + (kind == "Q" ? "queen" : (kind == "R" ? "rook" : (kind == "B" ? "bishop" : "knight")));
                            accessible-action-default => { root.promotion-chosen(kind.to-lowercase()); }
                            ChessPiece {
                                code: (root.promotion-white ? "w" : "b") + kind;
                                width: parent.width * 0.88;
                                height: parent.height * 0.88;
                            }
                            piece-touch := TouchArea {
                                clicked => { root.promotion-chosen(kind.to-lowercase()); }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button {
                            text: "Cancel";
                            accessible-label: "Cancel promotion";
                            clicked => { root.promotion-cancelled(); }
                        }
                    }
                }
            }
        }
    }

    pure function string-from-char-code(code: int) -> string {
        if (code == 97) { return "a"; }
        if (code == 98) { return "b"; }
        if (code == 99) { return "c"; }
        if (code == 100) { return "d"; }
        if (code == 101) { return "e"; }
        if (code == 102) { return "f"; }
        if (code == 103) { return "g"; }
        return "h";
    }
}

// Renders headers and the move tree as PGN movetext: moves in order, with each
// variation inline in parentheses after the move it replaces. Every move is one
// token in a single flat repeater. A token is a fixed-width cell (move number
// and opening parentheses, SAN, closing parentheses) placed by arithmetic on
// its index, so a resize only moves tokens: it never rebuilds them, and the
// focused move keeps focus. (Slint has no reflow layout for variable-width
// children in this toolchain version.) Click or activate a token to jump
// directly to that node of the tree.
export component NotationPanel inherits Rectangle {
    in property <string> white-name;
    in property <string> black-name;
    in property <string> event-name;
    in property <string> date;
    in property <string> result;
    in property <[NotationToken]> tokens;
    in property <int> current-node;
    in property <bool> has-game: false;
    in property <bool> unsaved: false;
    in property <bool> edited: false;
    in property <bool> interaction-enabled: true;
    callback node-activated(int);

    property <length> cell-width: 86px;
    property <length> cell-gap: 4px;
    property <length> row-height: 20px;
    property <length> row-gap: 4px;
    property <length> cell-stride: root.cell-width + root.cell-gap;
    property <int> cells-per-row: max(1, Math.floor((root.width - 20px + root.cell-gap) / root.cell-stride));
    // Mirrors `tokens.length` through an explicit assignment instead of a
    // binding. The host republishes the whole token list as a new model on
    // every navigation; a bound length would dirty the token repeater each
    // time, rebuilding every token and dropping keyboard focus from the move
    // the user was operating. An assignment of an unchanged length is silent.
    property <int> unit-count: 0;
    init => { root.unit-count = root.tokens.length; }
    changed tokens => { root.unit-count = root.tokens.length; }
    // (unit-count + cells-per-row - 1) / cells-per-row: ceil without the
    // truncating integer division inside Math.ceil, which floors first
    // and would hide the final partial row of moves.
    property <int> row-count: (root.unit-count + root.cells-per-row - 1) / root.cells-per-row;
    property <length> row-stride: root.row-height + root.row-gap;

    background: Palette.background;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        // Single elided lines: a wrapping header grew until it left the
        // move list no room at narrow widths.
        if root.white-name != "" || root.black-name != "": Text {
            text: root.white-name + " – " + root.black-name;
            color: Palette.foreground;
            font-size: 15px;
            font-weight: 700;
            overflow: elide;
        }
        if root.event-name != "" || root.date != "": Text {
            text: root.event-name != "" && root.date != "" ? root.event-name + " · " + root.date : root.event-name + root.date;
            color: Palette.alternate-foreground;
            font-size: 11px;
            overflow: elide;
        }
        if root.unsaved || root.edited: Text {
            text: root.unsaved ? "Unsaved game" : "Edited – not saved";
            color: Palette.accent-background;
            font-size: 11px;
            font-weight: 700;
            overflow: elide;
            accessible-role: text;
            accessible-description: root.unsaved ? "This game is not stored in any database" : "Moves added to this game are not stored in any database";
        }
        if !root.has-game: Text {
            text: "Play a move to start a new game, or open a game from the list.";
            color: Palette.alternate-foreground;
            font-size: 12px;
            wrap: word-wrap;
        }

        Flickable {
            vertical-stretch: 1;
            content-height: root.row-count * root.row-stride + (root.result != "" ? root.row-height : 0px);
            for idx in root.unit-count: cell := Rectangle {
                property <NotationToken> token: idx < root.tokens.length ? root.tokens[idx] : { lead: "", san: "", trail: "", node: -1, depth: 0 };
                property <bool> current: cell.token.node == root.current-node;
                x: Math.mod(idx, root.cells-per-row) * root.cell-stride;
                y: Math.floor(idx / root.cells-per-row) * root.row-stride;
                width: root.cell-width;
                height: root.row-height;
                move-scope := FocusScope {
                    width: root.cell-width;
                    height: root.row-height;
                    focus-on-tab-navigation: root.interaction-enabled;
                    accessible-role: button;
                    accessible-label: "Move " + (idx + 1) + ": " + cell.token.lead + " " + cell.token.san + cell.token.trail + (cell.token.depth > 0 ? ", variation" : "");
                    accessible-action-default => {
                        if (root.interaction-enabled) {
                            root.node-activated(cell.token.node);
                        }
                    }
                    key-pressed(event) => {
                        if (root.interaction-enabled && (event.text == "\n" || event.text == " ")) {
                            root.node-activated(cell.token.node);
                            return accept;
                        }
                        return reject;
                    }
                    if move-scope.has-focus: Rectangle {
                        border-width: 2px;
                        border-radius: 3px;
                        border-color: Palette.accent-background;
                        background: transparent;
                    }
                    HorizontalLayout {
                        padding-left: 3px;
                        spacing: 3px;
                        alignment: start;
                        if cell.token.lead != "": Text {
                            text: cell.token.lead;
                            color: Palette.alternate-foreground;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: cell.token.san + cell.token.trail;
                            color: cell.current ? Palette.accent-background : (cell.token.depth > 0 ? Palette.alternate-foreground : Palette.foreground);
                            font-weight: cell.current ? 700 : 400;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        enabled: root.interaction-enabled;
                        clicked => {
                            move-scope.focus();
                            root.node-activated(cell.token.node);
                        }
                    }
                }
            }
            if root.result != "": Text {
                x: 0px;
                y: root.row-count * root.row-stride;
                horizontal-alignment: left;
                text: root.result;
                color: Palette.alternate-foreground;
                font-weight: 700;
                font-size: 13px;
            }
        }
    }
}

component ReplayIconButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> icon-path;
    callback clicked();

    min-width: 32px;
    min-height: 32px;
    preferred-width: 32px;
    preferred-height: 32px;

    control-button := Button {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }

    Path {
        width: Math.min(parent.width, parent.height) * 0.56;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-path;
        fill: root.enabled ? Palette.foreground : Palette.alternate-foreground;
    }
}

component BoardAndControls inherits Rectangle {
    in property <bool> board-loaded;
    in property <[string]> square-pieces;
    in property <[SquareHighlight]> square-highlights;
    in property <bool> flipped;
    in property <bool> interaction-enabled: true;
    in property <bool> promotion-pending: false;
    in property <bool> promotion-white: true;

    callback square-activated(int, int);
    callback promotion-chosen(string);
    callback promotion-cancelled();
    callback navigate-first();
    callback navigate-previous();
    callback navigate-next();
    callback navigate-last();
    callback orientation-toggled();

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        spacing: StyleMetrics.layout-spacing;
        BoardPanel {
            vertical-stretch: 1;
            square-pieces: root.square-pieces;
            square-highlights: root.square-highlights;
            flipped: root.flipped;
            interaction-enabled: root.interaction-enabled;
            promotion-pending: root.promotion-pending;
            promotion-white: root.promotion-white;
            square-activated(file, rank) => { root.square-activated(file, rank); }
            promotion-chosen(piece) => { root.promotion-chosen(piece); }
            promotion-cancelled() => { root.promotion-cancelled(); }
        }
        HorizontalLayout {
            height: 32px;
            spacing: StyleMetrics.layout-spacing;
            alignment: center;
            Rectangle { horizontal-stretch: 1; }
            ReplayIconButton { label: "First move"; icon-path: "M5 5 L7 5 L7 19 L5 19 Z M19 5 L9 12 L19 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-first(); } }
            ReplayIconButton { label: "Previous move"; icon-path: "M17 5 L7 12 L17 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-previous(); } }
            ReplayIconButton { label: "Next move"; icon-path: "M7 5 L17 12 L7 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-next(); } }
            ReplayIconButton { label: "Last move"; icon-path: "M17 5 L19 5 L19 19 L17 19 Z M5 5 L15 12 L5 19 Z"; enabled: root.board-loaded && root.interaction-enabled; clicked => { root.navigate-last(); } }
            ReplayIconButton { label: "Flip board"; icon-path: "M7.6 6.4 A7.9 7.9 0 0 1 19.2 10 L22 10 L18 14 L14 10 L16.9 10 A5.8 5.8 0 0 0 8.8 8.2 Z M6 10 L10 14 L7.1 14 A5.8 5.8 0 0 0 15.2 15.8 L16.4 17.6 A7.9 7.9 0 0 1 4.8 14 L2 14 Z"; enabled: root.interaction-enabled; clicked => { root.orientation-toggled(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }

}
// Wraps board + notation with navigation and orientation controls. The board
// block is a square sized from this panel's own width/height, and notation
// takes whatever remains but never less than its minimum. Plain stretch
// factors let the board claim width it could not draw (it is square), which
// starved notation at wide windows and at the minimum window size.
export component GameReviewPanel inherits Rectangle {
    in property <bool> board-loaded;
    in property <[string]> square-pieces;
    in property <[SquareHighlight]> square-highlights;
    in property <bool> flipped;
    in property <string> white-name;
    in property <string> black-name;
    in property <string> event-name;
    in property <string> date;
    in property <string> result;
    in property <[NotationToken]> tokens;
    in property <int> current-node;
    in property <bool> unsaved: false;
    in property <bool> edited: false;
    in property <bool> promotion-pending: false;
    in property <bool> promotion-white: true;
    in property <bool> interaction-enabled: true;
    in property <bool> notation-below: false;
    // Incremented by the host each time a game finishes loading.
    in property <int> load-serial: 0;
    // Last load whose focus transfer happened. It lives with the host because
    // this panel is unmounted while the board is hidden; a game loaded in the
    // meantime still owes its transfer when the panel is mounted again.
    in property <int> focused-serial: 0;
    callback load-focused(int);
    changed load-serial => { keyboard-scope.focus-pending = true; }
    init => {
        if (root.load-serial != root.focused-serial) {
            if (root.board-loaded && root.interaction-enabled) {
                keyboard-scope.focus();
                root.load-focused(root.load-serial);
            } else {
                keyboard-scope.focus-pending = true;
            }
        }
    }

    callback square-activated(int, int);
    callback promotion-chosen(string);
    callback promotion-cancelled();
    callback node-activated(int);
    callback navigate-first();
    callback navigate-previous();
    callback navigate-next();
    callback navigate-last();
    callback orientation-toggled();

    property <length> gap: StyleMetrics.layout-spacing;
    property <length> controls-height: 32px;
    // BoardPanel's 220px minimum plus its 16px coordinate-label gutter.
    property <length> board-min-side: 236px;
    property <length> notation-min-width: 200px;
    // Narrowest width at which the board and a usable notation column fit side by side.
    out property <length> min-content-width: root.board-min-side + root.gap + root.notation-min-width;
    property <length> notation-min-height: 150px;
    property <length> beside-side: max(root.board-min-side, min(root.height - root.controls-height - root.gap, root.width - root.gap - root.notation-min-width));
    property <length> below-side: max(root.board-min-side, min(root.width, root.height - root.controls-height - 2 * root.gap - root.notation-min-height));
    property <length> board-side: root.notation-below ? root.below-side : root.beside-side;
    property <length> board-block-height: root.board-side + root.gap + root.controls-height;
    property <length> board-block-x: root.notation-below ? (root.width - root.board-side) / 2 : 0px;

    background: Palette.background;

    keyboard-scope := FocusScope {
        // Moves focus into the review region once per loaded game, so
        // arrow-key navigation works right after a game is opened without
        // a prior click. It is keyed on the load, not on
        // `interaction-enabled`: that flips every time an auto-search or
        // navigation runs, which pulled focus back off whatever control the
        // user was operating (a replay button, a notation move).
        property <bool> focus-pending: false;
        property <bool> can-auto-focus: self.focus-pending && root.board-loaded && root.interaction-enabled;
        changed can-auto-focus => {
            if (self.can-auto-focus) {
                self.focus-pending = false;
                self.focus();
                root.load-focused(root.load-serial);
            }
        }
        // Keys that a focused child (a replay button, a notation move) does
        // not consume bubble up to here, so Left/Right/Home/End keep
        // stepping the game without moving focus off that child.
        key-pressed(event) => {
            if (!root.interaction-enabled) {
                return reject;
            }
            if (event.text == Key.LeftArrow) {
                root.navigate-previous();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.navigate-next();
                return accept;
            }
            if (event.text == Key.Home) {
                root.navigate-first();
                return accept;
            }
            if (event.text == Key.End) {
                root.navigate-last();
                return accept;
            }
            return reject;
        }

        BoardAndControls {
            x: root.board-block-x;
            y: 0px;
            width: root.board-side;
            height: root.board-block-height;
            board-loaded: root.board-loaded;
            square-pieces: root.square-pieces;
            square-highlights: root.square-highlights;
            flipped: root.flipped;
            interaction-enabled: root.interaction-enabled;
            promotion-pending: root.promotion-pending;
            promotion-white: root.promotion-white;
            square-activated(file, rank) => { root.square-activated(file, rank); }
            promotion-chosen(piece) => { root.promotion-chosen(piece); }
            promotion-cancelled() => { root.promotion-cancelled(); }
            navigate-first() => { root.navigate-first(); }
            navigate-previous() => { root.navigate-previous(); }
            navigate-next() => { root.navigate-next(); }
            navigate-last() => { root.navigate-last(); }
            orientation-toggled() => { root.orientation-toggled(); }
        }
        NotationPanel {
            x: root.notation-below ? 0px : root.board-side + root.gap;
            y: root.notation-below ? root.board-block-height + root.gap : 0px;
            width: root.notation-below ? root.width : root.width - root.board-side - root.gap;
            height: root.notation-below ? root.height - root.board-block-height - root.gap : root.height;
            white-name: root.white-name;
            black-name: root.black-name;
            event-name: root.event-name;
            date: root.date;
            result: root.result;
            tokens: root.tokens;
            current-node: root.current-node;
            has-game: root.board-loaded;
            unsaved: root.unsaved;
            edited: root.edited;
            interaction-enabled: root.interaction-enabled;
            node-activated(node) => { root.node-activated(node); }
        }
        // Shows that the review region itself owns the keyboard (the state a
        // freshly loaded game starts in) when no individual control does.
        if keyboard-scope.has-focus: Rectangle {
            x: root.board-block-x;
            y: 0px;
            width: root.board-side;
            height: root.board-block-height;
            border-width: 2px;
            border-color: Palette.accent-background;
            background: transparent;
        }
    }
}
