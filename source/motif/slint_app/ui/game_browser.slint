import { Button, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, StyleMetrics } from "std-widgets.slint";

export struct GameRow {
    white: string,
    black: string,
    result: string,
    event: string,
    date: string,
    eco: string,
}

component TableHeader inherits Rectangle {
    in property <string> title;
    in property <int> column;
    in property <length> column-width;
    in property <bool> active;
    in property <bool> ascending;
    in property <bool> busy;
    callback sort(int, bool);
    callback resize(int, int);

    height: 36px;
    width: root.column-width;
    background: Palette.alternate-background;
    Text {
        x: 10px;
        width: parent.width - 18px;
        height: parent.height;
        vertical-alignment: center;
        color: Palette.alternate-foreground;
        text: root.title + (root.active ? (root.ascending ? "  ^" : "  v") : "");
        font-weight: 600;
    }
    TouchArea {
        width: parent.width - 5px;
        enabled: !root.busy;
        clicked => {
            root.sort(root.column, root.active ? !root.ascending : true);
        }
    }
    resize-handle := TouchArea {
        property <length> start-mouse-x;
        property <length> start-width;
        x: parent.width - 5px;
        width: 10px;
        mouse-cursor: col-resize;
        enabled: !root.busy;
        changed pressed => {
            if (self.pressed) {
                self.start-mouse-x = self.mouse-x;
                self.start-width = root.column-width;
            }
        }
        moved => {
            if (self.pressed) {
                root.resize(root.column, max(70, min(600, (self.start-width + self.mouse-x - self.start-mouse-x) / 1px)));
            }
        }
    }
}

// A check box that stays a tab stop while the workspace is busy: a disabled
// widget drops keyboard focus and would not get it back when a refresh ends.
// It never changes its own state; the host answers `toggled` by publishing the
// state it accepted, so a refused press leaves the box as it was.
component FollowToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> dimmed: false;
    callback toggled(bool);

    forward-focus: scope;
    background: transparent;
    border-radius: 4px;
    border-width: scope.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    opacity: root.dimmed ? 0.6 : 1.0;
    min-width: layout.min-width;
    preferred-width: layout.preferred-width;
    max-width: layout.preferred-width;
    horizontal-stretch: 0;

    scope := FocusScope {
        accessible-role: AccessibleRole.checkbox;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-label: "Show only games that reach the board position";
        key-pressed(event) => {
            if (!event.repeat && (event.text == " " || event.text == Key.Return)) {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }

    layout := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.checked ? Palette.accent-background : Palette.border;
            background: root.checked ? Palette.accent-background : Palette.control-background;
            if root.checked: Path {
                commands: "M 3 8.5 L 6.5 12 L 13 4.5";
                stroke: Palette.accent-foreground;
                stroke-width: 2px;
                width: 16px;
                height: 16px;
                viewbox-width: 16;
                viewbox-height: 16;
            }
        }
        Text {
            text: "Follow board";
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            scope.focus();
            root.toggled(!root.checked);
        }
    }
}

export component GameBrowser inherits Rectangle {
    in property <[GameRow]> games;
    in property <int> total-count;
    in property <int> page-index;
    in property <bool> has-previous-page;
    in property <bool> has-next-page;
    in property <bool> busy;
    in property <string> active-game-title;
    in-out property <int> selected-row: -1;
    in-out property <string> player-filter;
    in-out property <string> result-filter;
    in property <[int]> column-widths;
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;
    // Follow board: the list is the games that reach the board position.
    in property <bool> following: false;
    // A list query is in flight: the rows on screen are about to be replaced.
    in property <bool> refreshing: false;
    // The query has taken long enough to show a progress bar.
    in property <bool> progress-visible: false;
    // Explains an empty list or a failed refresh; empty when nothing needs saying.
    in property <string> status-text: "";
    // Changes whenever a result lands.
    in property <int> result-serial: 0;
    callback filters-changed(string, string);
    callback page-requested(int);
    callback select-row(int);
    callback move-selection(int);
    callback activate-selected();
    callback sort-requested(int, bool);
    callback column-resized(int, int);
    // Follow board: the user asked to switch it to the given state. The host
    // decides and publishes `following` either way.
    callback follow-toggled(bool);
    // The browser was mounted (it is not part of every preset).
    callback shown();

    property <length> white-width: root.column-widths.length == 6 ? root.column-widths[0] * 1px : 145px;
    property <length> black-width: root.column-widths.length == 6 ? root.column-widths[1] * 1px : 145px;
    property <length> result-width: root.column-widths.length == 6 ? root.column-widths[2] * 1px : 85px;
    property <length> event-width: root.column-widths.length == 6 ? root.column-widths[3] * 1px : 170px;
    property <length> date-width: root.column-widths.length == 6 ? root.column-widths[4] * 1px : 105px;
    property <length> eco-width: root.column-widths.length == 6 ? root.column-widths[5] * 1px : 70px;
    property <length> table-width: white-width + black-width + result-width + event-width + date-width + eco-width;
    property <length> row-height: 34px;
    // Keeps one row of overlap between consecutive PageUp/PageDown views.
    property <int> rows-per-page: max(1, Math.floor(list.visible-height / root.row-height) - 1);

    // Keyboard movement with no selection starts at the nearest end instead
    // of skipping a row.
    function step-selection(delta: int) {
        if (root.selected-row < 0) {
            root.select-row(delta > 0 ? 0 : root.games.length - 1);
        } else {
            root.move-selection(delta);
        }
    }

    // Scroll the table so a row stays inside the viewport.
    function reveal-row(row: int) {
        if (row >= 0) {
            if (row * root.row-height < -list.content-y) {
                list.content-y = -(row * root.row-height);
            } else if ((row + 1) * root.row-height > -list.content-y + list.visible-height) {
                list.content-y = list.visible-height - (row + 1) * root.row-height;
            }
        }
    }

    // `changed` does not fire when a key requests the row that is already
    // selected, so Home/End also call reveal-row directly.
    changed selected-row => { root.reveal-row(root.selected-row); }

    // The host replaces the model on every publish, and a ListView keeps its
    // scroll offset across that. A new result is a different list: start at
    // the top, then bring the selected game, if it is still there, into view.
    changed result-serial => {
        list.content-y = 0px;
        root.reveal-row(root.selected-row);
    }

    init => { root.shown(); }

    // The table itself scrolls horizontally. Its intrinsic column total must
    // not become the workspace sidebar's minimum width, or it defeats the
    // parent layout's proportional allocation.
    min-width: 0px;
    background: Palette.background;

    VerticalLayout {
        padding: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;

        HorizontalLayout {
            spacing: StyleMetrics.layout-spacing;
            LineEdit {
                horizontal-stretch: 1;
                input-type: search;
                placeholder-text: "Filter by player";
                text <=> root.player-filter;
                enabled: !root.busy;
                edited(value) => { root.filters-changed(value, root.result-filter); }
            }
            ComboBox {
                model: ["All results", "1-0", "0-1", "1/2-1/2"];
                current-value: root.result-filter == "" ? "All results" : root.result-filter;
                enabled: !root.busy;
                selected(value) => {
                    root.result-filter = value == "All results" ? "" : value;
                    root.filters-changed(root.player-filter, root.result-filter);
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Palette.background;

            VerticalLayout {
                spacing: 0px;
                // Keep the column headers on the same horizontal offset as
                // the ListView content; otherwise the body scrolls while its
                // headers remain at the origin.
                Rectangle {
                    height: 36px;
                    clip: true;
                    header := HorizontalLayout {
                        x: list.content-x;
                        width: root.table-width;
                        height: parent.height;
                        spacing: 0px;
                        TableHeader { title: "White"; column: 0; column-width: root.white-width; active: root.sort-column == 0; ascending: root.sort-ascending; busy: root.busy; sort(c, a) => { root.sort-requested(c, a); } resize(c, w) => { root.column-resized(c, w); } }
                        TableHeader { title: "Black"; column: 1; column-width: root.black-width; active: root.sort-column == 1; ascending: root.sort-ascending; busy: root.busy; sort(c, a) => { root.sort-requested(c, a); } resize(c, w) => { root.column-resized(c, w); } }
                        TableHeader { title: "Result"; column: 2; column-width: root.result-width; active: root.sort-column == 2; ascending: root.sort-ascending; busy: root.busy; sort(c, a) => { root.sort-requested(c, a); } resize(c, w) => { root.column-resized(c, w); } }
                        TableHeader { title: "Event"; column: 3; column-width: root.event-width; active: root.sort-column == 3; ascending: root.sort-ascending; busy: root.busy; sort(c, a) => { root.sort-requested(c, a); } resize(c, w) => { root.column-resized(c, w); } }
                        TableHeader { title: "Date"; column: 4; column-width: root.date-width; active: root.sort-column == 4; ascending: root.sort-ascending; busy: root.busy; sort(c, a) => { root.sort-requested(c, a); } resize(c, w) => { root.column-resized(c, w); } }
                        TableHeader { title: "ECO"; column: 5; column-width: root.eco-width; active: root.sort-column == 5; ascending: root.sort-ascending; busy: root.busy; sort(c, a) => { root.sort-requested(c, a); } resize(c, w) => { root.column-resized(c, w); } }
                    }
                }
                list-scope := FocusScope {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    // One tab stop for the whole table; Up/Down/Page/Home/End
                    // move the selection from there.
                    focus-on-tab-navigation: root.games.length > 0 && !root.busy;
                    accessible-role: AccessibleRole.list;
                    accessible-label: "Games";
                    // The focus stays on this scope while the selection moves,
                    // so the current game is exposed here as the value.
                    accessible-value: root.selected-row >= 0 && root.selected-row < root.games.length
                        ? root.games[root.selected-row].white + " versus " + root.games[root.selected-row].black + ", " + root.games[root.selected-row].result
                        : "No game selected";
                    accessible-item-count: root.games.length;
                    key-pressed(event) => {
                        if (root.busy || root.games.length == 0) {
                            return reject;
                        }
                        if (event.text == Key.DownArrow) {
                            root.step-selection(1);
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            root.step-selection(-1);
                            return accept;
                        }
                        if (event.text == Key.PageDown) {
                            root.step-selection(root.rows-per-page);
                            return accept;
                        }
                        if (event.text == Key.PageUp) {
                            root.step-selection(-root.rows-per-page);
                            return accept;
                        }
                        if (event.text == Key.Home) {
                            root.select-row(0);
                            root.reveal-row(0);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            root.select-row(root.games.length - 1);
                            root.reveal-row(root.games.length - 1);
                            return accept;
                        }
                        if (event.text == Key.Return || event.text == " ") {
                            root.activate-selected();
                            return accept;
                        }
                        return reject;
                    }
                    list := ListView {
                        content-width: max(self.width, root.table-width);
                        for row[index] in root.games: row-box := Rectangle {
                            property <bool> selected: index == root.selected-row;
                            property <color> row-foreground: row-box.selected ? Palette.selection-foreground : Palette.foreground;
                            // Rows of the list before the one being fetched: dimmed, and inert through `busy`.
                            opacity: root.refreshing ? 0.45 : 1.0;
                            width: root.table-width;
                            height: root.row-height;
                            accessible-role: AccessibleRole.list-item;
                            accessible-label: row.white + " versus " + row.black + ", " + row.result + ", " + row.event + ", " + row.date;
                            accessible-item-selected: row-box.selected;
                            accessible-item-index: index;
                            accessible-item-count: root.games.length;
                            background: row-box.selected ? Palette.selection-background : (Math.mod(index, 2) == 0 ? Palette.alternate-background : Palette.background);
                            border-width: row-box.selected ? (list-scope.has-focus ? 2px : 1px) : 0px;
                            border-color: list-scope.has-focus ? Palette.foreground : Palette.selection-foreground;
                            HorizontalLayout {
                                spacing: 0px;
                                Text { width: root.white-width; text: "  " + row.white; color: row-box.row-foreground; vertical-alignment: center; overflow: elide; }
                                Text { width: root.black-width; text: "  " + row.black; color: row-box.row-foreground; vertical-alignment: center; overflow: elide; }
                                Text { width: root.result-width; text: "  " + row.result; color: row-box.row-foreground; vertical-alignment: center; }
                                Text { width: root.event-width; text: "  " + row.event; color: row-box.row-foreground; vertical-alignment: center; overflow: elide; }
                                Text { width: root.date-width; text: "  " + row.date; color: row-box.row-foreground; vertical-alignment: center; }
                                Text { width: root.eco-width; text: "  " + row.eco; color: row-box.row-foreground; vertical-alignment: center; }
                            }
                            TouchArea {
                                enabled: !root.busy;
                                clicked => {
                                    root.select-row(index);
                                    list-scope.focus();
                                }
                                double-clicked => {
                                    root.select-row(index);
                                    root.activate-selected();
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                        root.select-row(index);
                                    }
                                }
                            }
                        }
                    }
                    // Whole-table focus ring: visible even before a row is selected.
                    if list-scope.has-focus: Rectangle {
                        border-width: 2px;
                        border-color: Palette.accent-background;
                        background: transparent;
                    }
                }
            }

            // Drawn over the table so that neither appearing nor going away
            // moves another control. Only the table body, below its header.
            if root.progress-visible: ProgressIndicator {
                x: 0px;
                y: 36px;
                width: parent.width;
                height: 4px;
                indeterminate: true;
                accessible-label: "Searching games";
            }
            if root.status-text != "" && !root.refreshing: Text {
                x: 8px;
                y: 36px + 16px;
                width: parent.width - 16px;
                text: root.status-text;
                color: Palette.alternate-foreground;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Two rows: the counters/title may elide, while the page and open
        // buttons keep their natural width. A single row forced the sidebar
        // wider than its allocation and clipped Open Game at small windows.
        // Follow board sits at the left of the counters row: a row of its own
        // would take the only table row Analysis has at 960x560.
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                FollowToggle {
                    checked: root.following;
                    dimmed: root.busy;
                    toggled(on) => { root.follow-toggled(on); }
                }
                Text {
                    text: root.total-count == 0 ? "No games" : "Games " + (root.page-index * 100 + 1) + "–" + min(root.total-count, (root.page-index + 1) * 100) + " of " + root.total-count;
                    color: Palette.alternate-foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.active-game-title != "": Text {
                    horizontal-stretch: 1;
                    text: "Loaded: " + root.active-game-title;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Previous";
                    accessible-label: "Previous page";
                    enabled: !root.busy && root.has-previous-page;
                    clicked => { root.page-requested(root.page-index - 1); }
                }
                Button {
                    text: "Next";
                    accessible-label: "Next page";
                    enabled: !root.busy && root.has-next-page;
                    clicked => { root.page-requested(root.page-index + 1); }
                }
                Button {
                    text: "Open Game";
                    enabled: !root.busy && root.selected-row >= 0;
                    clicked => { root.activate-selected(); }
                }
            }
        }
    }
}
