import { GameBrowser, GameRow } from "game_browser.slint";
import { GameReviewPanel, SquareHighlight } from "board_notation.slint";
import { ContinuationRow, PositionSearchPanel, SearchMatchRow } from "position_search.slint";
import { Button, LineEdit, Palette, StyleMetrics } from "std-widgets.slint";

export struct RecentEntry {
    name: string,
    path: string,
}

export component WorkspaceWindow inherits Window {
    in property <bool> has-database: false;
    in property <bool> is-scratch: false;
    in property <bool> busy: false;
    in property <bool> browser-busy: false;
    in property <string> display-name;
    in property <string> active-path;
    in-out property <string> error-text;
    in property <string> browser-error-text: "";
    in property <string> board-error-text: "";
    in property <string> search-error-text: "";
    in property <[RecentEntry]> recent-databases;
    in-out property <string> create-path-text;
    in-out property <string> create-name-text;
    in-out property <string> open-path-text;
    in-out property <string> import-path-text;
    in property <bool> import-active: false;
    in property <bool> import-status-visible: false;
    in property <string> import-state-text;
    in property <string> import-phase-text;
    in property <int> import-processed: 0;
    in property <int> import-total: 0;
    in property <int> import-committed: 0;
    in property <int> import-skipped: 0;
    in property <int> import-errors: 0;
    in property <[GameRow]> game-rows;
    in property <int> game-total-count;
    in property <int> game-page-index;
    in property <bool> game-has-previous-page;
    in property <bool> game-has-next-page;
    in-out property <int> game-selected-row: -1;
    in-out property <string> game-player-filter;
    in-out property <string> game-result-filter;
    in property <string> game-active-title;
    in property <[int]> game-column-widths;
    in property <int> game-sort-column: 0;
    in property <bool> game-sort-ascending: true;
    in property <bool> board-loaded;
    // Serial changes only for completed game loads. It lets the review panel
    // request keyboard focus once without reacting to generic busy-state flips.
    in property <int> board-load-serial: 0;
    property <int> board-focused-serial: 0;
    in property <[string]> board-square-pieces;
    in property <[SquareHighlight]> board-square-highlights;
    in property <bool> board-flipped;
    in property <string> board-white-name;
    in property <string> board-black-name;
    in property <string> board-event-name;
    in property <string> board-date;
    in property <string> board-result;
    in property <[string]> board-san-moves;
    in property <int> board-current-ply;
    in property <bool> board-panel-visible: true;
    in property <bool> notation-below: false;
    in property <[SearchMatchRow]> search-matches;
    in property <int> search-total-matches;
    in property <int> search-page-index;
    in property <bool> search-has-previous-page;
    in property <bool> search-has-next-page;
    in property <[ContinuationRow]> search-continuations;
    in property <int> search-total-games;
    in property <string> search-active-filter-summary;
    in property <bool> search-searching: false;
    in property <bool> search-auto-search: true;
    in property <bool> search-busy: false;

    // 0 = games browser, 1 = position explorer. Owned by the UI: the tabs
    // swap which sidebar panel is mounted, so no C++ round-trip is involved.
    in-out property <int> sidebar-tab: 0;

    callback create-requested(string, string);
    callback open-requested(string);
    callback scratch-requested();
    callback close-requested();
    callback dismiss-error();
    callback recent-activated(string);
    callback import-requested(string);
    callback cancel-import-requested();
    callback game-filters-changed(string, string);
    callback game-page-requested(int);
    callback game-selected(int);
    callback game-move-selection(int);
    callback game-activate-requested();
    callback game-sort-requested(int, bool);
    callback game-column-resized(int, int);
    callback board-square-activated(int, int);
    callback board-ply-activated(int);
    callback board-navigate-first();
    callback board-navigate-previous();
    callback board-navigate-next();
    callback board-navigate-last();
    callback board-orientation-toggled();
    callback board-panel-visibility-toggled();
    callback notation-layout-toggled();
    callback search-requested();
    callback search-auto-search-toggled(bool);
    callback search-match-activated(int);
    callback search-page-requested(int);

    property <bool> board-interaction-enabled: !root.busy && !root.browser-busy && !root.import-active && !root.search-busy;
    property <bool> search-interaction-enabled: !root.busy && !root.browser-busy && !root.import-active && !root.search-busy;
    // Direct workspace/import errors retain precedence; panel-specific
    // cleared state cannot erase an error owned by another source.
    property <string> merged-error-text: root.error-text != "" ? root.error-text
        : (root.search-error-text != "" ? root.search-error-text
        : (root.board-error-text != "" ? root.board-error-text
        : root.browser-error-text));
    property <bool> workspace-idle: !root.busy && !root.browser-busy && !root.search-busy && !root.import-active;
    // The review pane needs two usable columns, while the browser remains
    // useful at a narrower width because its table scrolls horizontally.
    // These are desktop usability floors and startup dimensions, not a
    // replacement for the stretch-based layout below.
    min-width: 1180px;
    preferred-width: 1440px;
    min-height: 640px;
    preferred-height: 860px;


    // The review and browser panes declare compatible baseline widths below;
    // stretch factors then consume every additional pixel proportionally.
    background: Palette.background;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        if !root.has-database: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    // Bounded so the setup forms do not stretch the full
                    // window width on a wide display. Expressed as a layout
                    // constraint rather than a width computed from root.width,
                    // which would make the parent's size depend on its child's.
                    max-width: 560px;
                    spacing: 14px;
                    Text {
                        text: "No database open";
                        font-size: 22px;
                        font-weight: 700;
                        color: Palette.foreground;
                    }
                    Rectangle {
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text { text: "Create a new database"; color: Palette.alternate-foreground; font-weight: 700; }
                            HorizontalLayout {
                                spacing: StyleMetrics.layout-spacing;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Directory path";
                                    text <=> root.create-path-text;
                                    enabled: !root.busy;
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Name";
                                    text <=> root.create-name-text;
                                    enabled: !root.busy;
                                }
                                Button {
                                    text: "Create";
                                    enabled: !root.busy && root.create-path-text != "" && root.create-name-text != "";
                                    clicked => { root.create-requested(root.create-path-text, root.create-name-text); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                            Text { text: "Open an existing database"; color: Palette.alternate-foreground; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Bundle directory path";
                                    text <=> root.open-path-text;
                                    enabled: !root.busy;
                                }
                                Button {
                                    text: "Open";
                                    enabled: !root.busy && root.open-path-text != "";
                                    clicked => { root.open-requested(root.open-path-text); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                            Button {
                                text: "Use Scratch Database";
                                enabled: !root.busy;
                                clicked => { root.scratch-requested(); }
                            }
                        }
                    }
                    if root.recent-databases.length > 0: Rectangle {
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;
                            Text { text: "Recent databases"; color: Palette.alternate-foreground; font-weight: 700; }
                            for entry[index] in root.recent-databases: entry-scope := FocusScope {
                                height: 44px;
                                key-pressed(event) => {
                                    if (!root.busy && (event.text == "\n" || event.text == " ")) {
                                        root.recent-activated(entry.path);
                                        return accept;
                                    }
                                    return reject;
                                }
                                Rectangle {
                                    border-radius: 3px;
                                    background: entry-scope.has-focus ? Palette.selection-background : transparent;
                                    TouchArea {
                                        enabled: !root.busy;
                                        clicked => {
                                            entry-scope.focus();
                                            root.recent-activated(entry.path);
                                        }
                                        VerticalLayout {
                                            padding: 6px;
                                            Text { text: entry.name; color: Palette.foreground; font-weight: 600; }
                                            Text { text: entry.path; color: Palette.alternate-foreground; font-size: 11px; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.has-database: Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 8px;

            if root.board-panel-visible: GameReviewPanel {
                min-width: 620px;
                preferred-width: 620px;
                horizontal-stretch: 2;
                vertical-stretch: 1;
                board-loaded: root.board-loaded;
                load-serial: root.board-load-serial;
                focused-serial: root.board-focused-serial;
                load-focused(serial) => { root.board-focused-serial = serial; }
                square-pieces: root.board-square-pieces;
                square-highlights: root.board-square-highlights;
                flipped: root.board-flipped;
                white-name: root.board-white-name;
                black-name: root.board-black-name;
                event-name: root.board-event-name;
                date: root.board-date;
                result: root.board-result;
                san-moves: root.board-san-moves;
                current-ply: root.board-current-ply;
                interaction-enabled: root.board-interaction-enabled;
                square-activated(file, rank) => { root.board-square-activated(file, rank); }
                notation-below: root.notation-below;
                ply-activated(ply) => { root.board-ply-activated(ply); }
                navigate-first() => { root.board-navigate-first(); }
                navigate-previous() => { root.board-navigate-previous(); }
                navigate-next() => { root.board-navigate-next(); }
                navigate-last() => { root.board-navigate-last(); }
                orientation-toggled() => { root.board-orientation-toggled(); }
                panel-visibility-toggled() => { root.board-panel-visibility-toggled(); }
                notation-layout-toggled() => { root.notation-layout-toggled(); }
            }

            VerticalLayout {
                min-width: 360px;
                preferred-width: 360px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: StyleMetrics.layout-spacing;

                HorizontalLayout {
                    spacing: StyleMetrics.layout-spacing;
                    Button {
                        text: "Games";
                        checked: root.sidebar-tab == 0;
                        clicked => { root.sidebar-tab = 0; }
                    }
                    Button {
                        text: "Explorer";
                        checked: root.sidebar-tab == 1;
                        clicked => { root.sidebar-tab = 1; }
                    }
                    if !root.board-panel-visible: Button {
                        text: "Show Board";
                        clicked => { root.board-panel-visibility-toggled(); }
                    }
                    // Which database is open stays visible here rather than in a
                    // dedicated header block, so the sidebar keeps its height.
                    Text {
                        horizontal-stretch: 1;
                        text: root.is-scratch ? "Scratch (temporary)" : root.display-name;
                        color: Palette.alternate-foreground;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                    Button {
                        text: "Close";
                        enabled: root.workspace-idle;
                        clicked => { root.close-requested(); }
                    }
                }

                if root.sidebar-tab == 0: GameBrowser {
                    vertical-stretch: 1;
                    games: root.game-rows;
                    total-count: root.game-total-count;
                    page-index: root.game-page-index;
                    has-previous-page: root.game-has-previous-page;
                    has-next-page: root.game-has-next-page;
                    busy: root.browser-busy;
                    active-game-title: root.game-active-title;
                    selected-row <=> root.game-selected-row;
                    player-filter <=> root.game-player-filter;
                    result-filter <=> root.game-result-filter;
                    sort-column: root.game-sort-column;
                    sort-ascending: root.game-sort-ascending;
                    column-widths: root.game-column-widths;
                    filters-changed(player, result) => { root.game-filters-changed(player, result); }
                    page-requested(page) => { root.game-page-requested(page); }
                    select-row(row) => { root.game-selected(row); }
                    move-selection(delta) => { root.game-move-selection(delta); }
                    activate-selected() => { root.game-activate-requested(); }
                    sort-requested(column, ascending) => { root.game-sort-requested(column, ascending); }
                    column-resized(column, width) => { root.game-column-resized(column, width); }
                }

                if root.sidebar-tab == 1: PositionSearchPanel {
                    vertical-stretch: 1;
                    has-database: root.has-database;
                    matches: root.search-matches;
                    total-matches: root.search-total-matches;
                    page-index: root.search-page-index;
                    has-previous-page: root.search-has-previous-page;
                    has-next-page: root.search-has-next-page;
                    continuations: root.search-continuations;
                    total-games: root.search-total-games;
                    active-filter-summary: root.search-active-filter-summary;
                    searching: root.search-searching;
                    auto-search: root.search-auto-search;
                    interaction-enabled: root.search-interaction-enabled;
                    search-requested() => { root.search-requested(); }
                    auto-search-toggled(enabled) => { root.search-auto-search-toggled(enabled); }
                    match-activated(row) => { root.search-match-activated(row); }
                    page-requested(page) => { root.search-page-requested(page); }
                }

                Rectangle {
                    // Height follows the contained rows so a longer status
                    // line or a scaled font is not clipped by a fixed value.
                    vertical-stretch: 0;
                    background: Palette.background;
                    VerticalLayout {
                        padding: StyleMetrics.layout-padding;
                        spacing: StyleMetrics.layout-spacing;
                        if !root.import-active: HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "PGN file path";
                                text <=> root.import-path-text;
                                enabled: !root.busy && !root.browser-busy && !root.search-busy;
                            }
                            Button {
                                text: "Import PGN";
                                enabled: !root.busy && !root.browser-busy && !root.search-busy && root.import-path-text != "";
                                clicked => { root.import-requested(root.import-path-text); }
                            }
                        }
                        if root.import-status-visible: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.import-state-text
                                    + (root.import-active && root.import-phase-text != "" ? " · " + root.import-phase-text : "")
                                    + " · " + root.import-processed + " / " + root.import-total + " processed · "
                                    + root.import-committed + " committed · " + root.import-skipped + " skipped · "
                                    + root.import-errors + " errors";
                                color: Palette.alternate-foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.import-active: Button {
                                text: "Cancel";
                                enabled: root.import-state-text != "Canceling";
                                clicked => { root.cancel-import-requested(); }
                            }
                        }
                    }
                }
            }
            }
        }

        // Always mounted so that a transient error or the busy indicator does
        // not reflow the panels above it.
        Rectangle {
            vertical-stretch: 0;
            min-height: 30px;
            border-radius: 3px;
            background: root.merged-error-text != "" ? Palette.selection-background : transparent;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.merged-error-text != "" ? root.merged-error-text : (root.busy ? "Working…" : "");
                    color: root.merged-error-text != "" ? Palette.selection-foreground : Palette.accent-foreground;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if root.merged-error-text != "": Button {
                    text: "Dismiss";
                    clicked => { root.dismiss-error(); }
                }
            }
        }
    }
}
