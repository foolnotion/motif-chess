import { AnalysisLine, EnginePanel } from "engine_panel.slint";
import { GameBrowser, GameRow } from "game_browser.slint";
import { GameReviewPanel, NotationToken, SquareHighlight } from "board_notation.slint";
import { ContinuationRow, ContinuationTotal, PositionSearchPanel, SearchMatchRow } from "position_search.slint";
import { Button, LineEdit, Palette, ScrollView, StyleMetrics } from "std-widgets.slint";

export struct RecentEntry {
    name: string,
    path: string,
    // False when the bundle's files are no longer on disk.
    available: bool,
}

// Fixed workspace compositions (Story 13.1). Mirrors
// motif::slint_app::workspace_preset_kind. Presets choose which panel fills the
// sidebar and how the row is divided; there is no docking, floating, or
// draggable placement.
export enum WorkspacePreset { review, explorer, analysis }

export component WorkspaceWindow inherits Window {
    in property <bool> has-database: false;
    in property <bool> is-scratch: false;
    in property <bool> busy: false;
    in property <bool> browser-busy: false;
    in property <string> display-name;
    in property <string> active-path;
    in-out property <string> error-text;
    in property <string> browser-error-text: "";
    in property <string> board-error-text: "";
    in property <string> search-error-text: "";
    in property <[RecentEntry]> recent-databases;
    // PGN files from the command line still waiting for a database to import into.
    in property <int> queued-import-count: 0;
    in-out property <string> create-path-text;
    in-out property <string> create-name-text;
    in-out property <string> open-path-text;
    in-out property <string> import-path-text;
    in property <bool> import-active: false;
    in property <bool> import-status-visible: false;
    in property <string> import-state-text;
    in property <string> import-phase-text;
    in property <int> import-processed: 0;
    in property <int> import-total: 0;
    in property <int> import-committed: 0;
    in property <int> import-skipped: 0;
    in property <int> import-errors: 0;
    in property <[GameRow]> game-rows;
    in property <int> game-total-count;
    in property <int> game-page-index;
    in property <bool> game-has-previous-page;
    in property <bool> game-has-next-page;
    in-out property <int> game-selected-row: -1;
    in-out property <string> game-player-filter;
    in-out property <string> game-result-filter;
    in property <string> game-active-title;
    in property <[int]> game-column-widths;
    in property <int> game-sort-column: 0;
    in property <bool> game-sort-ascending: true;
    // A game, stored or unsaved, is on the board. The board itself is always
    // playable: an empty one shows the starting position.
    in property <bool> board-loaded;
    in property <bool> board-unsaved: false;
    in property <bool> board-edited: false;
    in property <bool> board-promotion-pending: false;
    in property <bool> board-promotion-white: true;
    in property <[string]> board-square-pieces;
    in property <[SquareHighlight]> board-square-highlights;
    in property <bool> board-flipped;
    in property <string> board-white-name;
    in property <string> board-black-name;
    in property <string> board-event-name;
    in property <string> board-date;
    in property <string> board-result;
    in property <[NotationToken]> board-notation;
    in property <int> board-current-node: 0;
    // Characters of the longest notation token; sizes the notation cells.
    in property <int> board-notation-chars: 0;
    // Incremented by the host each time a game finishes loading; moves
    // keyboard focus into the review region once per load.
    in property <int> board-load-serial: 0;
    property <int> board-focused-serial: 0;
    in property <bool> board-panel-visible: true;
    in property <bool> notation-below: false;
    in property <[SearchMatchRow]> search-matches;
    in property <int> search-total-matches;
    in property <int> search-page-index;
    in property <bool> search-has-previous-page;
    in property <bool> search-has-next-page;
    in property <[ContinuationRow]> search-continuations;
    in property <ContinuationTotal> search-continuation-total;
    in property <int> search-total-games;
    in property <string> search-active-filter-summary;
    in property <bool> search-searching: false;
    in property <bool> search-auto-search: true;
    in property <bool> search-busy: false;
    // The explorer rows were searched for another position than the board's (auto-search off).
    in property <bool> search-rows-stale: false;
    // Engine analysis panel (Story 13.3), shown in the Analysis preset. The host
    // publishes analysis_presenter's state; the panel draws it.
    in property <[string]> analysis-engine-names;
    in-out property <int> analysis-selected-engine: -1;
    in-out property <int> analysis-multipv: 3;
    // 0 limits the search by depth, 1 by move time.
    in-out property <int> analysis-limit-kind: 0;
    in-out property <int> analysis-limit-value: 20;
    in property <bool> analysis-active: false;
    in property <string> analysis-status-text;
    in property <string> analysis-notice;
    in property <[AnalysisLine]> analysis-lines;
    in property <bool> analysis-lines-stale: false;
    in property <bool> analysis-can-start: false;
    in-out property <string> analysis-engine-path-text;
    // In-window confirmation shown before an edited or unsaved game is
    // replaced; the host owns the pending action.
    in property <bool> confirm-visible: false;
    in property <string> confirm-message;
    in property <string> confirm-action-label;

    // The active preset. The toolbar sets it directly so the switch is
    // immediate; the host persists it through `preset-selected` and restores it
    // from the per-user configuration when the workspace is published.
    in-out property <WorkspacePreset> workspace-preset: WorkspacePreset.review;

    callback create-requested(string, string);
    callback open-requested(string);
    callback scratch-requested();
    callback close-requested();
    callback dismiss-error();
    callback recent-activated(string);
    callback recent-removed(string);
    callback import-requested(string);
    callback cancel-import-requested();
    callback game-filters-changed(string, string);
    callback game-page-requested(int);
    callback game-selected(int);
    callback game-move-selection(int);
    callback game-activate-requested();
    callback game-sort-requested(int, bool);
    callback game-column-resized(int, int);
    callback board-square-activated(int, int);
    callback board-node-activated(int);
    callback board-promotion-chosen(string);
    callback board-promotion-cancelled();
    // Plays a move written in SAN as board input would (entry point for 13.2).
    callback board-play-san(string);
    callback board-new-game-requested();
    callback confirm-accepted();
    callback confirm-cancelled();
    callback board-navigate-first();
    callback board-navigate-previous();
    callback board-navigate-next();
    callback board-navigate-last();
    callback board-orientation-toggled();
    callback board-panel-visibility-toggled();
    callback notation-layout-toggled();
    callback analysis-start-requested();
    callback analysis-stop-requested();
    callback analysis-engine-selected(int);
    callback analysis-engine-added(string);
    callback analysis-engine-removed();
    callback analysis-multipv-changed(int);
    callback analysis-limit-kind-changed(int);
    callback analysis-limit-value-changed(int);
    // Leaving the Analysis preset unmounts the panel; the host stops the analysis.
    callback analysis-panel-left();
    callback preset-selected(WorkspacePreset);
    callback search-requested();
    callback search-auto-search-toggled(bool);
    callback search-match-activated(int);
    callback search-page-requested(int);
    callback search-continuation-activated(string);

    function select-preset(preset: WorkspacePreset) {
        root.workspace-preset = preset;
        root.preset-selected(preset);
    }

    // Compact panels for a short window. Assigned from the window height rather
    // than bound to it: a layout size bound to `height` forms a binding loop,
    // and the Explorer panel's own binding is already one too many.
    property <bool> short-window: false;
    init => { root.short-window = root.height < 640px; }
    changed height => { root.short-window = root.height < 640px; }
    changed workspace-preset => {
        if (root.workspace-preset != WorkspacePreset.analysis) {
            root.analysis-panel-left();
        }
    }

    property <bool> board-interaction-enabled: !root.busy && !root.browser-busy && !root.import-active && !root.search-busy && !root.confirm-visible;
    property <bool> search-interaction-enabled: !root.busy && !root.browser-busy && !root.import-active && !root.search-busy && !root.confirm-visible;
    // Direct workspace/import errors retain precedence; panel-specific
    // cleared state cannot erase an error owned by another source.
    property <string> merged-error-text: root.error-text != "" ? root.error-text
        : (root.search-error-text != "" ? root.search-error-text
        : (root.board-error-text != "" ? root.board-error-text
        : root.browser-error-text));
    property <bool> workspace-idle: !root.busy && !root.browser-busy && !root.search-busy && !root.import-active;
    // The platform supplies the initial logical size and scale factor. Keep
    // this component's constraints in logical units and let the compositor
    // choose the native physical size.
    min-width: 960px;
    preferred-width: 1200px;
    min-height: 560px;
    preferred-height: 720px;


    // The review and browser panes declare compatible baseline widths below;
    // stretch factors then consume every additional pixel proportionally.
    background: Palette.background;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        if !root.has-database: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    // Bounded so the setup forms do not stretch the full
                    // window width on a wide display. Expressed as a layout
                    // constraint rather than a width computed from root.width,
                    // which would make the parent's size depend on its child's.
                    max-width: 560px;
                    spacing: 14px;
                    Text {
                        text: "No database open";
                        font-size: 22px;
                        font-weight: 700;
                        color: Palette.foreground;
                    }
                    if root.queued-import-count > 0: Text {
                        text: root.queued-import-count == 1
                            ? "1 PGN file from the command line will be imported once a database is open."
                            : root.queued-import-count + " PGN files from the command line will be imported once a database is open.";
                        color: Palette.alternate-foreground;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text { text: "Create a new database"; color: Palette.alternate-foreground; font-weight: 700; }
                            HorizontalLayout {
                                spacing: StyleMetrics.layout-spacing;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Directory path";
                                    text <=> root.create-path-text;
                                    enabled: !root.busy;
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Name";
                                    text <=> root.create-name-text;
                                    enabled: !root.busy;
                                }
                                Button {
                                    text: "Create";
                                    enabled: !root.busy && root.create-path-text != "" && root.create-name-text != "";
                                    clicked => { root.create-requested(root.create-path-text, root.create-name-text); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                            Text { text: "Open an existing database"; color: Palette.alternate-foreground; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Bundle directory path";
                                    text <=> root.open-path-text;
                                    enabled: !root.busy;
                                }
                                Button {
                                    text: "Open";
                                    enabled: !root.busy && root.open-path-text != "";
                                    clicked => { root.open-requested(root.open-path-text); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                            Button {
                                text: "Use Scratch Database";
                                enabled: !root.busy;
                                clicked => { root.scratch-requested(); }
                            }
                        }
                    }
                    if root.recent-databases.length > 0: Rectangle {
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;
                            Text { text: "Recent databases"; color: Palette.alternate-foreground; font-weight: 700; }
                            // Capped to about four rows; the rest scroll, so up to the
                            // stored maximum of recent entries stays reachable.
                            ScrollView {
                                height: min(root.recent-databases.length * 52px, 208px);
                                VerticalLayout {
                                    spacing: 4px;
                                    // Leaves room so the overlay scrollbar never covers Remove.
                                    padding-right: 14px;
                                    for entry[index] in root.recent-databases: HorizontalLayout {
                                        height: 48px;
                                        spacing: 6px;
                                        entry-scope := FocusScope {
                                            horizontal-stretch: 1;
                                            key-pressed(event) => {
                                                if (!root.busy && entry.available && (event.text == "\n" || event.text == " ")) {
                                                    root.recent-activated(entry.path);
                                                    return accept;
                                                }
                                                if (!root.busy && event.text == Key.Delete) {
                                                    root.recent-removed(entry.path);
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                            Rectangle {
                                                border-radius: 3px;
                                                background: entry-scope.has-focus ? Palette.selection-background : transparent;
                                                TouchArea {
                                                    enabled: !root.busy && entry.available;
                                                    clicked => {
                                                        entry-scope.focus();
                                                        root.recent-activated(entry.path);
                                                    }
                                                    VerticalLayout {
                                                        padding: 6px;
                                                        Text {
                                                            text: entry.available ? entry.name : entry.name + " (unavailable)";
                                                            color: entry.available ? Palette.foreground : Palette.alternate-foreground;
                                                            font-weight: 600;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: entry.available ? entry.path : "Database files not found at " + entry.path;
                                                            color: Palette.alternate-foreground;
                                                            font-size: 11px;
                                                            overflow: elide;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Remove";
                                                enabled: !root.busy;
                                                clicked => { root.recent-removed(entry.path); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.has-database: Rectangle {
            vertical-stretch: 0;
            HorizontalLayout {
                spacing: StyleMetrics.layout-spacing;
                Text {
                    horizontal-stretch: 1;
                    text: "Board & Notation";
                    color: Palette.alternate-foreground;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Button {
                    text: "New Game";
                    enabled: root.board-interaction-enabled;
                    accessible-description: "Clears the board to the starting position and begins an unsaved game";
                    clicked => { root.board-new-game-requested(); }
                }
                Button {
                    text: root.notation-below ? "Notation Right" : "Notation Below";
                    enabled: root.board-interaction-enabled;
                    clicked => { root.notation-layout-toggled(); }
                }
                // One button whose label changes. Two `if` buttons destroyed
                // the focused element on toggle and dropped keyboard focus.
                Button {
                    text: root.board-panel-visible ? "Hide Board" : "Show Board";
                    enabled: root.board-interaction-enabled;
                    clicked => { root.board-panel-visibility-toggled(); }
                }
                Button {
                    text: "Review";
                    checked: root.workspace-preset == WorkspacePreset.review;
                    accessible-description: "Board, notation and game browser";
                    clicked => { root.select-preset(WorkspacePreset.review); }
                }
                Button {
                    text: "Explorer";
                    checked: root.workspace-preset == WorkspacePreset.explorer;
                    accessible-description: "Board, notation and opening explorer";
                    clicked => { root.select-preset(WorkspacePreset.explorer); }
                }
                Button {
                    text: "Analysis";
                    checked: root.workspace-preset == WorkspacePreset.analysis;
                    accessible-description: "Large board with engine analysis and the game browser";
                    clicked => { root.select-preset(WorkspacePreset.analysis); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.is-scratch ? "Scratch (temporary)" : root.display-name;
                    color: Palette.alternate-foreground;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                Button {
                    text: "Close";
                    enabled: root.workspace-idle;
                    clicked => { root.close-requested(); }
                }
            }
        }

        if root.has-database: Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 8px;

            if root.board-panel-visible: GameReviewPanel {
                // Stretch factors only divide the space left after each pane's
                // minimum, so the review pane's minimum (board plus a usable
                // notation column) is what keeps it from being starved.
                min-width: self.min-content-width;
                preferred-width: 0px;
                // Review 2:1, Explorer 1:1 (the sidebar hosts the explorer),
                // Analysis 3:1 (board-led). The ratios divide only the space
                // above each pane's minimum, so at the minimum window width
                // every preset has the same, fully visible composition.
                horizontal-stretch: root.workspace-preset == WorkspacePreset.explorer ? 1 : (root.workspace-preset == WorkspacePreset.analysis ? 3 : 2);
                vertical-stretch: 1;
                board-loaded: root.board-loaded;
                square-pieces: root.board-square-pieces;
                square-highlights: root.board-square-highlights;
                flipped: root.board-flipped;
                white-name: root.board-white-name;
                black-name: root.board-black-name;
                event-name: root.board-event-name;
                date: root.board-date;
                result: root.board-result;
                tokens: root.board-notation;
                current-node: root.board-current-node;
                longest-token-chars: root.board-notation-chars;
                unsaved: root.board-unsaved;
                edited: root.board-edited;
                promotion-pending: root.board-promotion-pending;
                promotion-white: root.board-promotion-white;
                interaction-enabled: root.board-interaction-enabled;
                load-serial: root.board-load-serial;
                focused-serial: root.board-focused-serial;
                load-focused(serial) => { root.board-focused-serial = serial; }
                square-activated(file, rank) => { root.board-square-activated(file, rank); }
                notation-below: root.notation-below;
                node-activated(node) => { root.board-node-activated(node); }
                promotion-chosen(piece) => { root.board-promotion-chosen(piece); }
                promotion-cancelled() => { root.board-promotion-cancelled(); }
                navigate-first() => { root.board-navigate-first(); }
                navigate-previous() => { root.board-navigate-previous(); }
                navigate-next() => { root.board-navigate-next(); }
                navigate-last() => { root.board-navigate-last(); }
                orientation-toggled() => { root.board-orientation-toggled(); }
            }

            VerticalLayout {
                // Wide enough that the games footer (page and open buttons)
                // is never clipped at the minimum window width.
                min-width: 320px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: StyleMetrics.layout-spacing;

                if root.workspace-preset == WorkspacePreset.analysis: EnginePanel {
                    vertical-stretch: 1;
                    engine-names: root.analysis-engine-names;
                    selected-engine <=> root.analysis-selected-engine;
                    multipv <=> root.analysis-multipv;
                    limit-kind <=> root.analysis-limit-kind;
                    limit-value <=> root.analysis-limit-value;
                    active: root.analysis-active;
                    status-text: root.analysis-status-text;
                    notice: root.analysis-notice;
                    lines: root.analysis-lines;
                    lines-stale: root.analysis-lines-stale;
                    can-start: root.analysis-can-start;
                    config-enabled: !root.busy;
                    compact: root.short-window;
                    path-text <=> root.analysis-engine-path-text;
                    start-requested() => { root.analysis-start-requested(); }
                    stop-requested() => { root.analysis-stop-requested(); }
                    engine-selected(index) => { root.analysis-engine-selected(index); }
                    engine-added(path) => { root.analysis-engine-added(path); }
                    engine-removed() => { root.analysis-engine-removed(); }
                    multipv-changed(count) => { root.analysis-multipv-changed(count); }
                    limit-kind-changed(kind) => { root.analysis-limit-kind-changed(kind); }
                    limit-value-changed(value) => { root.analysis-limit-value-changed(value); }
                }
                if root.workspace-preset != WorkspacePreset.explorer: GameBrowser {
                    vertical-stretch: 1;
                    games: root.game-rows;
                    total-count: root.game-total-count;
                    page-index: root.game-page-index;
                    has-previous-page: root.game-has-previous-page;
                    has-next-page: root.game-has-next-page;
                    busy: root.browser-busy || root.confirm-visible;
                    active-game-title: root.game-active-title;
                    selected-row <=> root.game-selected-row;
                    player-filter <=> root.game-player-filter;
                    result-filter <=> root.game-result-filter;
                    sort-column: root.game-sort-column;
                    sort-ascending: root.game-sort-ascending;
                    column-widths: root.game-column-widths;
                    filters-changed(player, result) => { root.game-filters-changed(player, result); }
                    page-requested(page) => { root.game-page-requested(page); }
                    select-row(row) => { root.game-selected(row); }
                    move-selection(delta) => { root.game-move-selection(delta); }
                    activate-selected() => { root.game-activate-requested(); }
                    sort-requested(column, ascending) => { root.game-sort-requested(column, ascending); }
                    column-resized(column, width) => { root.game-column-resized(column, width); }
                }

                if root.workspace-preset == WorkspacePreset.explorer: PositionSearchPanel {
                    vertical-stretch: 1;
                    has-database: root.has-database;
                    matches: root.search-matches;
                    total-matches: root.search-total-matches;
                    page-index: root.search-page-index;
                    has-previous-page: root.search-has-previous-page;
                    has-next-page: root.search-has-next-page;
                    continuations: root.search-continuations;
                    continuation-total: root.search-continuation-total;
                    total-games: root.search-total-games;
                    active-filter-summary: root.search-active-filter-summary;
                    searching: root.search-searching;
                    auto-search: root.search-auto-search;
                    interaction-enabled: root.search-interaction-enabled;
                    compact: root.height < 640px;
                    stale: root.search-rows-stale;
                    search-requested() => { root.search-requested(); }
                    auto-search-toggled(enabled) => { root.search-auto-search-toggled(enabled); }
                    match-activated(row) => { root.search-match-activated(row); }
                    page-requested(page) => { root.search-page-requested(page); }
                    continuation-activated(san) => { root.search-continuation-activated(san); }
                }

                Rectangle {
                    // Height follows the contained rows so a longer status
                    // line or a scaled font is not clipped by a fixed value.
                    vertical-stretch: 0;
                    background: Palette.background;
                    VerticalLayout {
                        padding: StyleMetrics.layout-padding;
                        spacing: StyleMetrics.layout-spacing;
                        if !root.import-active: HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "PGN file path";
                                text <=> root.import-path-text;
                                enabled: !root.busy && !root.browser-busy && !root.search-busy;
                            }
                            Button {
                                text: "Import PGN";
                                enabled: !root.busy && !root.browser-busy && !root.search-busy && root.import-path-text != "";
                                clicked => { root.import-requested(root.import-path-text); }
                            }
                        }
                        if root.import-status-visible: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.import-state-text
                                    + (root.import-active && root.import-phase-text != "" ? " · " + root.import-phase-text : "")
                                    + " · " + root.import-processed + " / " + root.import-total + " processed · "
                                    + root.import-committed + " committed · " + root.import-skipped + " skipped · "
                                    + root.import-errors + " errors"
                                    + (root.queued-import-count > 0 ? " · " + root.queued-import-count + " queued" : "");
                                color: Palette.alternate-foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.import-active: Button {
                                text: "Cancel";
                                enabled: root.import-state-text != "Canceling";
                                clicked => { root.cancel-import-requested(); }
                            }
                        }
                    }
                }
            }
            }
        }

        // Always mounted so that a transient error or the busy indicator does
        // not reflow the panels above it.
        Rectangle {
            vertical-stretch: 0;
            min-height: 30px;
            border-radius: 3px;
            background: root.merged-error-text != "" ? Palette.selection-background : transparent;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.merged-error-text != "" ? root.merged-error-text : (root.busy ? "Working…" : "");
                    color: root.merged-error-text != "" ? Palette.selection-foreground : Palette.accent-foreground;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if root.merged-error-text != "": Button {
                    text: "Dismiss";
                    clicked => { root.dismiss-error(); }
                }
            }
        }
    }

    if root.confirm-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000aa;
        // Swallows pointer input meant for the workspace underneath.
        TouchArea { }
        confirm-scope := FocusScope {
            init => { keep-button.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.confirm-cancelled();
                    return accept;
                }
                // Focus stays on the two answers while the overlay is up, so
                // Tab can never reach (or leave Escape unheard by) the
                // workspace underneath. With neither answer focused (after a
                // click on the backdrop) Tab lands on the safe one.
                if (event.text == Key.Tab || event.text == Key.Backtab) {
                    if (keep-button.has-focus) {
                        discard-button.focus();
                    } else {
                        keep-button.focus();
                    }
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        min-width: 320px;
                        max-width: 460px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;
                        accessible-role: groupbox;
                        accessible-label: "Confirm replacing the game";
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            Text {
                                text: "Discard the game on the board?";
                                color: Palette.foreground;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.confirm-message;
                                color: Palette.foreground;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                keep-button := Button {
                                    text: "Keep editing";
                                    clicked => { root.confirm-cancelled(); }
                                }
                                discard-button := Button {
                                    text: root.confirm-action-label;
                                    clicked => { root.confirm-accepted(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
